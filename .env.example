# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL connection variables (injected automatically by Cloud SQL runtime)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="applysmart"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="admin_password"
